{
  "name": "monochromation",
  "version": "1.0.0",
  "description": "Seed-colour UI theming: pick one colour, get a full light and dark token set as CSS variables",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "typecheck": "tsc --noEmit",
    "build:lib": "vite build --mode lib && tsc -p tsconfig.build.json",
    "build:demo": "vite build"
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ]
}
